# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────

APP_NAME=RepoGuard
APP_VERSION=0.1.0
ENV=development            # development | staging | production | test
DEBUG=false                # true echoes all SQL

# ─────────────────────────────────────────────────────────────
# API Keys — all optional; the scanner runs without them
# ─────────────────────────────────────────────────────────────

# Raises the GitHub API rate limit from 60 to 5000 req/hour.
GITHUB_TOKEN=

# Only needed for gated/private Hugging Face repos.
HF_TOKEN=

# Reserved for the planned model-card analysis layer (not yet wired).
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────

DATABASE_URL=sqlite+aiosqlite:///./repoguard.db

# ─────────────────────────────────────────────────────────────
# CORS — comma-separated, must include the Vite dev server
# ─────────────────────────────────────────────────────────────

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# ─────────────────────────────────────────────────────────────
# Scanner limits
# ─────────────────────────────────────────────────────────────

MAX_FILES_PER_SCAN=100
MAX_FILE_SIZE_KB=512
SCAN_TIMEOUT_SECONDS=30
